# Environment Configuration for Gridify

# Backend Go API
PORT=8080
ENV=development
DATABASE_URL=postgres://postgres:admin@localhost:5432/gridify?sslmode=disable
SESSION_SECRET=gridify_secure_session_secret_key_minimum_32_bytes_test
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SMTP_URL=smtp://localhost:1025

# PostgreSQL Container Defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=gridify
POSTGRES_PORT=5432

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080
